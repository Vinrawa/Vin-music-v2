rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /songs/{songId} {
      // Authenticated users can read shared song metadata (BPM, energy, genres)
      allow read: if request.auth != null;

      // The app's only shared write is {likedByCount: FieldValue.increment(n)}
      // via set(merge) — the previous rules required full metadata fields on
      // every write, so like-counts for NEW songs were silently rejected with
      // PERMISSION_DENIED. These rules validate exactly that write shape.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['likedByCount'])
        && request.resource.data.likedByCount is number
        && request.resource.data.likedByCount >= 0
        && request.resource.data.likedByCount <= 1000000;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedByCount'])
        && request.resource.data.likedByCount is number
        && request.resource.data.likedByCount >= 0
        && request.resource.data.likedByCount <= 1000000;

      // No delete allowed — shared data is append-only.
      // NOTE: if a future feature writes full song *metadata* again (title/
      // artist/status/bpmReal/...), reintroduce validated-field checks for those
      // writes here — do not widen these rules to accept arbitrary fields.
      allow delete: if false;
    }

    // User private data and cloud backups:
    // Grants the authenticated owner full access (read, write, create, update, delete)
    // to their user document and all nested subcollections (likedSongs, followedArtists,
    // playlists, playlists/{id}/songs, interactions, profile, etc.),
    // while preventing access from other users or unauthenticated clients.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
