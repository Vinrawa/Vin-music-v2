<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (Android 12+). Keep the session cookie and account
     identity out of cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vin_music_prefs.xml" />
        <exclude domain="sharedpref" path="vin_music_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vin_music_prefs.xml" />
        <exclude domain="sharedpref" path="vin_music_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
